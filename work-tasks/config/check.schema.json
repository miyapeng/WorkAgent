{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:workagent:stage4:check",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "file_exists"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "format": {
          "enum": [
            "csv",
            "json",
            "xlsx",
            "md",
            "txt",
            "pdf",
            "docx",
            "pptx"
          ]
        }
      },
      "required": [
        "kind",
        "path",
        "format"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "csv_columns"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "minItems": 1,
          "maxItems": 200,
          "uniqueItems": true
        }
      },
      "required": [
        "kind",
        "path",
        "columns"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "json_fields"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "pointers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "minItems": 1,
          "maxItems": 200,
          "uniqueItems": true
        }
      },
      "required": [
        "kind",
        "path",
        "pointers"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "numeric_formula"
          ]
        },
        "target": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "format": {
                  "enum": [
                    "csv"
                  ]
                },
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                },
                "key": {
                  "type": "object",
                  "minProperties": 1,
                  "maxProperties": 5,
                  "additionalProperties": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  }
                },
                "column": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                },
                "unit_column": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                }
              },
              "required": [
                "format",
                "path",
                "key",
                "column",
                "unit_column"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "format": {
                  "enum": [
                    "json"
                  ]
                },
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                },
                "pointer": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                },
                "unit_pointer": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                }
              },
              "required": [
                "format",
                "path",
                "pointer",
                "unit_pointer"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "format": {
                  "enum": [
                    "xlsx"
                  ]
                },
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                },
                "sheet": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                },
                "cell": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                },
                "unit_cell": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                }
              },
              "required": [
                "format",
                "path",
                "sheet",
                "cell",
                "unit_cell"
              ]
            }
          ]
        },
        "formula": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": {
              "enum": [
                "add",
                "subtract",
                "divide",
                "sum"
              ]
            },
            "operands": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "evidence_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  },
                  "column": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "evidence_id",
                  "column"
                ]
              },
              "minItems": 1,
              "maxItems": 200,
              "uniqueItems": true
            }
          },
          "required": [
            "op",
            "operands"
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "unit_evidence_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "absolute_tolerance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "relative_tolerance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "kind",
        "target",
        "formula",
        "unit",
        "unit_evidence_id",
        "absolute_tolerance",
        "relative_tolerance"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "input_final_integrity"
          ]
        }
      },
      "required": [
        "kind"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "semantic_guide"
          ]
        },
        "full_credit": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "minItems": 1,
          "maxItems": 200,
          "uniqueItems": true
        },
        "common_errors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "minItems": 1,
          "maxItems": 200,
          "uniqueItems": true
        },
        "conflict_policy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      },
      "required": [
        "kind",
        "full_credit",
        "common_errors",
        "conflict_policy"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "requires_execution_trace"
          ]
        },
        "condition": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "required_trace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      },
      "required": [
        "kind",
        "condition",
        "required_trace"
      ]
    }
  ]
}
