{
  "type": "object",
  "properties": {
    "interface": {
      "const": "asset-evidence-v1"
    },
    "seed_id": {
      "type": "string",
      "minLength": 1
    },
    "grounded_graph_sha256": {
      "type": "string",
      "minLength": 1
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file_id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "file_id",
          "path",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "commission_requirement",
              "asset_binding",
              "derived_requirement",
              "decision_requirement"
            ]
          },
          "information_node_id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "references": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "file_id": {
                  "type": "string",
                  "minLength": 1
                },
                "segment_id": {
                  "type": "string",
                  "minLength": 1
                },
                "locator": {
                  "type": "string",
                  "minLength": 1
                },
                "content": {
                  "type": "string",
                  "minLength": 1
                },
                "verification_status": {
                  "enum": [
                    "source_located",
                    "model_observation_unverified"
                  ]
                },
                "evidence_method": {
                  "enum": [
                    "programmatic_extraction",
                    "model_visual_observation"
                  ]
                },
                "box": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "minItems": 4,
                  "maxItems": 4
                },
                "image_sha256": {
                  "type": "string"
                },
                "timestamp_seconds": {
                  "type": "number",
                  "minimum": 0
                },
                "frame_sha256": {
                  "type": "string"
                }
              },
              "required": [
                "file_id",
                "segment_id",
                "locator",
                "content",
                "verification_status",
                "evidence_method"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "evidence_id",
          "type",
          "information_node_id",
          "description",
          "references"
        ],
        "additionalProperties": false
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "minItems": 2,
        "maxItems": 2
      }
    },
    "observation_policy": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "interface",
    "seed_id",
    "grounded_graph_sha256",
    "assets",
    "nodes",
    "dependencies",
    "observation_policy"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:workagent:stage4:asset_evidence"
}
