{
  "vocabulary": "execution_patterns.json",
  "retrieval": {
    "provider": "url_manifest",
    "manifest": "occupational_sources.json",
    "timeout_seconds": 20,
    "max_sources_per_pair": 2,
    "max_passages_per_pair": 3
  },
  "llm": {
    "model": "GLM_ka48dn",
    "model_name": "glm-5.2",
    "model_resolution": "LLMCenter /v1/models, 2026-11-10; model is the gateway accessId, not the upstream name.",
    "endpoint": "https://llm-center.modelbest.co/v1/chat/completions",
    "api_key_env": "WORK_SEEDS_API_KEY",
    "parameters": {"temperature": 0, "max_tokens": 4096, "thinking": {"type": "disabled"}},
    "timeout_seconds": 60,
    "candidates_per_pair": 2
  }
}
