{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["seed_id", "occupation_code", "dwa_id", "source_task_ids", "work_demand", "execution_pattern", "input_file_families", "evidence_ids"],
  "properties": {
    "seed_id": {"type": "string", "pattern": "^seed_[0-9a-f]{24}$"},
    "occupation_code": {"type": "string", "pattern": "^[0-9]{2}-[0-9]{4}\\.[0-9]{2}$"},
    "dwa_id": {"type": "string", "minLength": 1},
    "source_task_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "work_demand": {"type": "string", "minLength": 20, "maxLength": 800},
    "execution_pattern": {"type": "string", "minLength": 1},
    "input_file_families": {"type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^ev_[0-9a-f]{24}$"}}
  }
}
