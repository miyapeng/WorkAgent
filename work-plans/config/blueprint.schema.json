{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "seed_id": {
      "type": "string",
      "minLength": 1
    },
    "work_objective": {
      "type": "string",
      "minLength": 1
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "type": {
            "enum": [
              "direct_answer",
              "report",
              "spreadsheet",
              "presentation",
              "code_notebook",
              "visual_design",
              "structured_data",
              "document_revision",
              "web_app",
              "video",
              "model_3d"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "preferred_formats": {
            "type": "array",
            "items": {
              "enum": [
                "blend",
                "css",
                "csv",
                "docx",
                "glb",
                "gltf",
                "html",
                "ipynb",
                "jpeg",
                "jpg",
                "js",
                "json",
                "jsx",
                "md",
                "mov",
                "mp3",
                "mp4",
                "obj",
                "pdf",
                "png",
                "pptx",
                "py",
                "stl",
                "svg",
                "tex",
                "tiff",
                "ts",
                "tsx",
                "txt",
                "wav",
                "webm",
                "xlsx",
                "zip"
              ]
            },
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "type",
          "description",
          "preferred_formats"
        ]
      },
      "minItems": 1
    },
    "information_nodes": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
              },
              "type": {
                "const": "external_input"
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "supply_channel": {
                "enum": [
                  "task_instruction",
                  "workspace",
                  "external_reference"
                ]
              },
              "critical": {
                "type": "boolean"
              },
              "modality_candidates": {
                "type": "array",
                "items": {
                  "enum": [
                    "image",
                    "spatial",
                    "video",
                    "audio"
                  ]
                },
                "minItems": 0,
                "uniqueItems": true
              },
              "modality_rationale": {
                "type": "string",
                "minLength": 0
              },
              "kind": {
                "enum": [
                  "text_instruction",
                  "document",
                  "table",
                  "image",
                  "diagram",
                  "code",
                  "structured_data",
                  "video",
                  "audio",
                  "model_3d"
                ]
              },
              "preferred_formats": {
                "type": "array",
                "items": {
                  "enum": [
                    "blend",
                    "css",
                    "csv",
                    "docx",
                    "glb",
                    "gltf",
                    "html",
                    "ipynb",
                    "jpeg",
                    "jpg",
                    "js",
                    "json",
                    "jsx",
                    "md",
                    "mov",
                    "mp3",
                    "mp4",
                    "obj",
                    "pdf",
                    "png",
                    "pptx",
                    "py",
                    "stl",
                    "svg",
                    "tex",
                    "tiff",
                    "ts",
                    "tsx",
                    "txt",
                    "wav",
                    "webm",
                    "xlsx",
                    "zip"
                  ]
                },
                "uniqueItems": true
              }
            },
            "required": [
              "id",
              "type",
              "description",
              "supply_channel",
              "critical",
              "modality_candidates",
              "modality_rationale",
              "kind",
              "preferred_formats"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
              },
              "type": {
                "enum": [
                  "derived_information",
                  "professional_judgment"
                ]
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "type",
              "description"
            ]
          }
        ]
      },
      "minItems": 1
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          }
        ],
        "minItems": 2,
        "maxItems": 2
      },
      "minItems": 1
    },
    "modality_hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "node_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "modality_candidate": {
            "enum": [
              "image",
              "spatial",
              "video",
              "audio"
            ]
          },
          "information_needed": {
            "type": "string",
            "minLength": 1
          },
          "modality_rationale": {
            "type": "string",
            "minLength": 1
          },
          "evidence_status": {
            "const": "unretrieved"
          },
          "necessity_status": {
            "const": "hypothesis"
          },
          "supports_node_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          }
        },
        "required": [
          "node_id",
          "modality_candidate",
          "information_needed",
          "modality_rationale",
          "evidence_status",
          "necessity_status",
          "supports_node_id"
        ]
      },
      "minItems": 0
    }
  },
  "required": [
    "seed_id",
    "work_objective",
    "deliverables",
    "information_nodes",
    "dependencies",
    "modality_hypotheses"
  ]
}
