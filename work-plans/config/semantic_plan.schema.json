{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "deliverable": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "direct_answer",
            "report",
            "spreadsheet",
            "presentation",
            "code_notebook",
            "visual_design",
            "structured_data",
            "document_revision",
            "web_app",
            "video",
            "model_3d"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "preferred_formats": {
          "type": "array",
          "items": {
            "enum": [
              "blend",
              "css",
              "csv",
              "docx",
              "glb",
              "gltf",
              "html",
              "ipynb",
              "jpeg",
              "jpg",
              "js",
              "json",
              "jsx",
              "md",
              "mov",
              "mp3",
              "mp4",
              "obj",
              "pdf",
              "png",
              "pptx",
              "py",
              "stl",
              "svg",
              "tex",
              "tiff",
              "ts",
              "tsx",
              "txt",
              "wav",
              "webm",
              "xlsx",
              "zip"
            ]
          },
          "uniqueItems": true
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "kind",
        "description",
        "preferred_formats",
        "requires"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "direct_answer"
              }
            }
          },
          "then": {
            "properties": {
              "preferred_formats": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "report"
              }
            }
          },
          "then": {
            "properties": {
              "preferred_formats": {
                "items": {
                  "enum": [
                    "pdf",
                    "docx",
                    "md",
                    "txt",
                    "tex"
                  ]
                },
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "spreadsheet"
              }
            }
          },
          "then": {
            "properties": {
              "preferred_formats": {
                "items": {
                  "enum": [
                    "xlsx",
                    "csv"
                  ]
                },
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "presentation"
              }
            }
          },
          "then": {
            "properties": {
              "preferred_formats": {
                "items": {
                  "enum": [
                    "pptx",
                    "pdf"
                  ]
                },
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "code_notebook"
              }
            }
          },
          "then": {
            "properties": {
              "preferred_formats": {
                "items": {
                  "enum": [
                    "py",
                    "ipynb",
                    "js"
                  ]
                },
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "visual_design"
              }
            }
          },
          "then": {
            "properties": {
              "preferred_formats": {
                "items": {
                  "enum": [
                    "png",
                    "jpg",
                    "svg",
                    "pdf"
                  ]
                },
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "structured_data"
              }
            }
          },
          "then": {
            "properties": {
              "preferred_formats": {
                "items": {
                  "enum": [
                    "json",
                    "csv"
                  ]
                },
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "document_revision"
              }
            }
          },
          "then": {
            "properties": {
              "preferred_formats": {
                "items": {
                  "enum": [
                    "docx",
                    "pdf",
                    "md",
                    "tex"
                  ]
                },
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "web_app"
              }
            }
          },
          "then": {
            "properties": {
              "preferred_formats": {
                "items": {
                  "enum": [
                    "zip",
                    "html"
                  ]
                },
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "video"
              }
            }
          },
          "then": {
            "properties": {
              "preferred_formats": {
                "items": {
                  "enum": [
                    "mp4",
                    "webm",
                    "mov"
                  ]
                },
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "model_3d"
              }
            }
          },
          "then": {
            "properties": {
              "preferred_formats": {
                "items": {
                  "enum": [
                    "obj",
                    "gltf",
                    "glb",
                    "stl",
                    "blend"
                  ]
                },
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "kind": {
            "enum": [
              "text_instruction",
              "document",
              "table",
              "image",
              "diagram",
              "code",
              "structured_data",
              "video",
              "audio",
              "model_3d"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "enum": [
              "task_instruction",
              "workspace",
              "external_reference"
            ]
          },
          "preferred_formats": {
            "type": "array",
            "items": {
              "enum": [
                "blend",
                "css",
                "csv",
                "docx",
                "glb",
                "gltf",
                "html",
                "ipynb",
                "jpeg",
                "jpg",
                "js",
                "json",
                "jsx",
                "md",
                "mov",
                "mp3",
                "mp4",
                "obj",
                "pdf",
                "png",
                "pptx",
                "py",
                "stl",
                "svg",
                "tex",
                "tiff",
                "ts",
                "tsx",
                "txt",
                "wav",
                "webm",
                "xlsx",
                "zip"
              ]
            },
            "uniqueItems": true
          },
          "critical": {
            "type": "boolean"
          },
          "modality_dependency": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "modality": {
                "enum": [
                  "visual",
                  "visual_spatial",
                  "temporal_visual",
                  "auditory"
                ]
              },
              "information_needed": {
                "type": "string",
                "minLength": 1
              },
              "required_operation": {
                "type": "string",
                "minLength": 1
              },
              "supports": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              }
            },
            "required": [
              "modality",
              "information_needed",
              "required_operation",
              "supports"
            ]
          }
        },
        "required": [
          "name",
          "kind",
          "description",
          "source",
          "preferred_formats"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "text_instruction"
                }
              }
            },
            "then": {
              "properties": {
                "preferred_formats": {
                  "maxItems": 0
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "document"
                }
              }
            },
            "then": {
              "properties": {
                "preferred_formats": {
                  "items": {
                    "enum": [
                      "pdf",
                      "docx",
                      "md",
                      "txt",
                      "tex"
                    ]
                  },
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "table"
                }
              }
            },
            "then": {
              "properties": {
                "preferred_formats": {
                  "items": {
                    "enum": [
                      "csv",
                      "xlsx"
                    ]
                  },
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "image"
                }
              }
            },
            "then": {
              "properties": {
                "preferred_formats": {
                  "items": {
                    "enum": [
                      "png",
                      "jpg",
                      "jpeg",
                      "tiff"
                    ]
                  },
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "diagram"
                }
              }
            },
            "then": {
              "properties": {
                "preferred_formats": {
                  "items": {
                    "enum": [
                      "svg",
                      "png",
                      "pdf"
                    ]
                  },
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "code"
                }
              }
            },
            "then": {
              "properties": {
                "preferred_formats": {
                  "items": {
                    "enum": [
                      "py",
                      "js",
                      "ipynb",
                      "css",
                      "ts",
                      "tsx",
                      "jsx"
                    ]
                  },
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "structured_data"
                }
              }
            },
            "then": {
              "properties": {
                "preferred_formats": {
                  "items": {
                    "enum": [
                      "json"
                    ]
                  },
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "video"
                }
              }
            },
            "then": {
              "properties": {
                "preferred_formats": {
                  "items": {
                    "enum": [
                      "mp4",
                      "mov",
                      "webm"
                    ]
                  },
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "audio"
                }
              }
            },
            "then": {
              "properties": {
                "preferred_formats": {
                  "items": {
                    "enum": [
                      "wav",
                      "mp3"
                    ]
                  },
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "model_3d"
                }
              }
            },
            "then": {
              "properties": {
                "preferred_formats": {
                  "items": {
                    "enum": [
                      "obj",
                      "gltf",
                      "glb",
                      "stl"
                    ]
                  },
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "type": {
            "enum": [
              "derived_information",
              "professional_judgment"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "name",
          "type",
          "description",
          "requires"
        ]
      }
    }
  },
  "required": [
    "objective",
    "deliverable",
    "inputs",
    "operations"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
