{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "seed_id": {
      "type": "string",
      "minLength": 1
    },
    "work_objective": {
      "type": "string",
      "minLength": 1
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "type",
          "description"
        ]
      },
      "minItems": 1
    },
    "information_nodes": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
              },
              "type": {
                "const": "external_input"
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "supply_channel": {
                "enum": [
                  "task_instruction",
                  "workspace",
                  "external_reference"
                ]
              },
              "critical": {
                "type": "boolean"
              },
              "modality_candidates": {
                "type": "array",
                "items": {
                  "enum": [
                    "text",
                    "table",
                    "image",
                    "audio",
                    "video",
                    "diagram",
                    "spatial"
                  ]
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "modality_rationale": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "type",
              "description",
              "supply_channel",
              "critical",
              "modality_candidates",
              "modality_rationale"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
              },
              "type": {
                "enum": [
                  "derived_information",
                  "professional_judgment"
                ]
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "type",
              "description"
            ]
          }
        ]
      },
      "minItems": 1
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          }
        ],
        "minItems": 2,
        "maxItems": 2
      },
      "minItems": 1
    },
    "modality_hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "node_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "modality_candidate": {
            "enum": [
              "image",
              "audio",
              "video",
              "diagram",
              "spatial"
            ]
          },
          "information_needed": {
            "type": "string",
            "minLength": 1
          },
          "modality_rationale": {
            "type": "string",
            "minLength": 1
          },
          "evidence_status": {
            "const": "unretrieved"
          },
          "necessity_status": {
            "const": "hypothesis"
          }
        },
        "required": [
          "node_id",
          "modality_candidate",
          "information_needed",
          "modality_rationale",
          "evidence_status",
          "necessity_status"
        ]
      },
      "minItems": 0
    }
  },
  "required": [
    "seed_id",
    "work_objective",
    "deliverables",
    "information_nodes",
    "dependencies",
    "modality_hypotheses"
  ]
}
