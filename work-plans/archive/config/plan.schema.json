{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["seed_id", "work_objective", "deliverables", "information_nodes", "dependencies"],
  "properties": {
    "seed_id": {"type": "string", "pattern": "^seed_[0-9a-f]{24}$"},
    "work_objective": {"type": "string", "minLength": 20, "maxLength": 1000},
    "deliverables": {
      "type": "array", "minItems": 1, "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "type", "description"],
        "properties": {
          "id": {"type": "string", "pattern": "^out[1-9][0-9]*$"},
          "type": {"type": "string", "pattern": "^[a-z][a-z_]*$", "maxLength": 50},
          "description": {"type": "string", "minLength": 8, "maxLength": 600}
        }
      }
    },
    "information_nodes": {
      "type": "array", "minItems": 1, "maxItems": 20,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "type", "description"],
        "properties": {
          "id": {"type": "string", "pattern": "^i[1-9][0-9]*$"},
          "type": {"enum": ["external_input", "derived_information", "professional_judgment"]},
          "description": {"type": "string", "minLength": 8, "maxLength": 600}
        }
      }
    },
    "dependencies": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string", "minLength": 2}}
    }
  }
}
