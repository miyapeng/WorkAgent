{
  "type": "object",
  "properties": {
    "interface": {
      "const": "asset-grounded-graph-v1"
    },
    "seed_id": {
      "type": "string",
      "minLength": 1
    },
    "blueprint_sha256": {
      "type": "string",
      "minLength": 1
    },
    "case_title": {
      "type": "string",
      "minLength": 1
    },
    "case_objective": {
      "type": "string",
      "minLength": 1
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file_id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "file_id",
          "path",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "information_node_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "supported",
              "partial",
              "missing",
              "conflicted"
            ]
          },
          "references": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "file_id": {
                  "type": "string",
                  "minLength": 1
                },
                "segment_id": {
                  "type": "string",
                  "minLength": 1
                },
                "locator": {
                  "type": "string",
                  "minLength": 1
                },
                "content": {
                  "type": "string",
                  "minLength": 1
                },
                "verification_status": {
                  "enum": [
                    "source_located",
                    "model_observation_unverified"
                  ]
                },
                "evidence_method": {
                  "enum": [
                    "programmatic_extraction",
                    "model_visual_observation"
                  ]
                },
                "box": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "minItems": 4,
                  "maxItems": 4
                },
                "image_sha256": {
                  "type": "string"
                },
                "timestamp_seconds": {
                  "type": "number",
                  "minimum": 0
                },
                "frame_sha256": {
                  "type": "string"
                }
              },
              "required": [
                "file_id",
                "segment_id",
                "locator",
                "content",
                "verification_status",
                "evidence_method"
              ],
              "additionalProperties": false
            }
          },
          "instruction": {
            "type": [
              "string",
              "null"
            ]
          },
          "origin": {
            "enum": [
              "synthetic_instruction",
              "real_original"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "information_node_id",
          "status",
          "references",
          "instruction",
          "origin",
          "rationale"
        ],
        "additionalProperties": false
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "node_id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "node_id",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "node_id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "format": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "node_id",
          "description",
          "format"
        ],
        "additionalProperties": false
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "minItems": 2,
        "maxItems": 2
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "interface",
    "seed_id",
    "blueprint_sha256",
    "case_title",
    "case_objective",
    "assets",
    "bindings",
    "operations",
    "deliverables",
    "dependencies",
    "limitations"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
